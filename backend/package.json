{
  "name": "sourcify-backend",
  "version": "1.0.0",
  "description": "Sourcify - Multi-source Self-Healing RAG Platform (Backend)",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --no-deprecation -q server.js",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "dev:all": "concurrently -n BACKEND,FRONTEND -c blue,green --raw \"npm:dev\" \"npm:dev:frontend\""
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.4.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.4"
  }
}