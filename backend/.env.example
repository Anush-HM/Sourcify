# MongoDB Atlas connection string.
# Get this from Atlas → Database → Connect → Drivers.
# Must start with mongodb+srv:// — db.js forces DNS to 8.8.8.8/8.8.4.4
# to work around ISPs/routers that block the SRV lookups this needs.
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@your_cluster.mongodb.net/sourcify

# Any long random string — used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# Port the Express server listens on. 3000 matches the frontend's
# same-origin static file serving in server.js — change both together.
PORT=3000

# development | production
# Only affects the session cookie's `secure` flag (server.js) — set to
# production when actually deployed behind HTTPS, otherwise leave as development.
NODE_ENV=development

# Gemini API key — primary LLM. Free tier available at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — fallback LLM when Gemini fails (services/llm.js).
# Free tier available at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here